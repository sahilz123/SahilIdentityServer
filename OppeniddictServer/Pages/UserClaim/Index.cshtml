@page
@model OppeniddictServer.Pages.UserClaim.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>User Claim Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.UserIdentityUserClaim[0].Id)
            </th><th>
                @Html.DisplayNameFor(model => model.UserIdentityUserClaim[0].UserId)
            </th><th>
                @Html.DisplayNameFor(model => model.UserIdentityUserClaim[0].ClaimType)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.UserIdentityUserClaim[0].ClaimValue)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.UserIdentityUserClaim) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Id)
            </td> <td>
                @Html.DisplayFor(modelItem => item.UserId)
            </td> <td>
                @Html.DisplayFor(modelItem => item.ClaimType)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ClaimValue)
            </td>
            <td>
                    <div class="d-flex flex-column">
                        <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-primary btn-sm mb-1">Edit</a>
                        <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-info btn-sm mb-1">Details</a>
                        <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Delete</a>
                    </div>
            </td>
        </tr>
}
    </tbody>
</table>

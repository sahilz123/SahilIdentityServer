@page
@model OppeniddictServer.Pages.RoleClaim.EditModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Role Claim</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="UserIdentityRoleClaim.Id" />
           
            <div class="form-group">
                <label asp-for="UserIdentityRoleClaim.RoleId" class="control-label">Role ID</label>
                <input asp-for="UserIdentityRoleClaim.RoleId" class="form-control" readonly />

            </div>
            <div class="form-group">
                <label asp-for="UserIdentityRoleClaim.ClaimType" class="control-label"></label>
                <input asp-for="UserIdentityRoleClaim.ClaimType" class="form-control" />
                <span asp-validation-for="UserIdentityRoleClaim.ClaimType" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="UserIdentityRoleClaim.ClaimValue" class="control-label"></label>
                <input asp-for="UserIdentityRoleClaim.ClaimValue" class="form-control" />
                <span asp-validation-for="UserIdentityRoleClaim.ClaimValue" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

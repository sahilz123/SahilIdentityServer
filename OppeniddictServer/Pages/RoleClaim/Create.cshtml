@page
@model OppeniddictServer.Pages.RoleClaim.CreateModel

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Role Claim</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Role" class="control-label"> Pick A Role</label>
                <select asp-for="SelectedRoleId" class="form-control">
                    <option value="" disabled selected>-- Select a Role --</option>
                    @foreach (var s in Model.Role)
                    {

                        <option value="@s.Id" >
                            @s.Name
                        </option>
                    }
               </select>

            </div>
            <div class="form-group">
                <label asp-for="RoleClaim.ClaimType" class="control-label"></label>
                <input asp-for="RoleClaim.ClaimType" class="form-control" />
                <span asp-validation-for="RoleClaim.ClaimType" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="RoleClaim.ClaimValue" class="control-label"></label>
                <input asp-for="RoleClaim.ClaimValue" class="form-control" />
                <span asp-validation-for="RoleClaim.ClaimValue" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

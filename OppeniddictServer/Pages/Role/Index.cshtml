@page
@model OppeniddictServer.Pages.Role.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Roles Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>

<div style="height:600px;overflow-y:scroll">

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.UserIdentityRole[0].Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.UserIdentityRole[0].NormalizedName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.UserIdentityRole[0].ConcurrencyStamp)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.UserIdentityRole) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.NormalizedName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ConcurrencyStamp)
            </td>
            <td>
                <div class="d-flex flex-column">
                    <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-primary btn-sm mb-1">Edit</a>
                    <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-info btn-sm mb-1">Details</a>
                    <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Delete</a>
                </div>
            </td>
        </tr>
}
    </tbody>
</table>
</div>

@page
@model OppeniddictServer.Pages.User.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>

<div style="overflow-x: auto; width: 100%;">

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.UserIdentity[0].UserName)
            </th>
            
            <th>
                @Html.DisplayNameFor(model => model.UserIdentity[0].Email)
            </th>
            
            <th>
                @Html.DisplayNameFor(model => model.UserIdentity[0].EmailConfirmed)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.UserIdentity[0].PasswordHash)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.UserIdentity[0].SecurityStamp)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.UserIdentity[0].ConcurrencyStamp)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.UserIdentity[0].PhoneNumber)
            </th>
           
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.UserIdentity) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.UserName)
            </td>
            
            <td>
                @Html.DisplayFor(modelItem => item.Email)
            </td>
            
            <td>
                @Html.DisplayFor(modelItem => item.EmailConfirmed)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PasswordHash)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.SecurityStamp)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ConcurrencyStamp)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PhoneNumber)
            </td>
            
                    <td>
                        <div class="d-flex flex-column">
                            <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-primary btn-sm mb-1">Edit</a>
                            <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-info btn-sm mb-1">Details</a>
                            <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Delete</a>
                        </div>
                    </td>
        </tr>
}
    </tbody>
</table>
</div>

@page
@model OppeniddictServer.Pages.User.CreateModel

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>User</h4>
<hr />
<style>
    .dropdown {
        position: relative;
        display: inline-block;
        width: 200px;
    }

    .dropdown-list {
        position: absolute;
        background-color: white;
        border: 1px solid #ccc;
        max-height: 150px;
        overflow-y: auto;
        width: 100%;
        display: none; /* Initially hidden */
        z-index: 1000;
    }

        .dropdown-list div {
            padding: 8px;
            cursor: pointer;
        }

            .dropdown-list div:hover {
                background-color: #f0f0f0;
            }

    .selected-items {
        display: flex;
        flex-wrap: wrap;
        border: 1px solid #ccc;
        padding: 5px;
        min-height: 30px;
        align-items: center;
        gap: 5px;
    }

        .selected-items span {
            background-color: #e0e0e0;
            padding: 5px;
            border-radius: 4px;
            display: flex;
            align-items: center;
            gap: 5px;
        }

            .selected-items span button {
                border: none;
                background: transparent;
                cursor: pointer;
                font-size: 12px;
            }

    #searchInput {
        width: 100%;
        box-sizing: border-box;
    }
</style>
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <!-- User ID (Readonly) -->
            <div class="form-group">
                <label asp-for="UserIdentity.Id" class="control-label">User ID</label>
                <input value="@Guid.NewGuid()" class="form-control" readonly />

            </div>

            <div class="form-group">
                <label asp-for="UserIdentity.UserName" class="control-label"></label>
                <input asp-for="UserIdentity.UserName" class="form-control" required type="text"/>
                <span asp-validation-for="UserIdentity.UserName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="UserIdentity.Email" class="control-label"></label>
                <input asp-for="UserIdentity.Email" class="form-control" type="email" required  />
                <span asp-validation-for="UserIdentity.Email" class="text-danger"></span>
            </div>
  
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="UserIdentity.EmailConfirmed" /> @Html.DisplayNameFor(model => model.UserIdentity.EmailConfirmed)
                </label>
            </div>
            
            <div class="form-group">
                <label asp-for="UserIdentity.PhoneNumber" class="control-label"></label>
                <input asp-for="UserIdentity.PhoneNumber" class="form-control"  type="number" maxlength=10 />
                <span asp-validation-for="UserIdentity.PhoneNumber" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="UserIdentity.PhoneNumberConfirmed" /> @Html.DisplayNameFor(model => model.UserIdentity.PhoneNumberConfirmed)
                </label>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="UserIdentity.TwoFactorEnabled" /> @Html.DisplayNameFor(model => model.UserIdentity.TwoFactorEnabled)
                </label>
            </div>
            <div class="form-group">
                <label asp-for="UserIdentity.LockoutEnd" class="control-label"></label>
                <input asp-for="UserIdentity.LockoutEnd" class="form-control" />
                <span asp-validation-for="UserIdentity.LockoutEnd" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="UserIdentity.LockoutEnabled" /> @Html.DisplayNameFor(model => model.UserIdentity.LockoutEnabled)
                </label>
            </div>
            <div class="form-group">
                <label asp-for="UserIdentity.AccessFailedCount" class="control-label"></label>
                <input asp-for="UserIdentity.AccessFailedCount" class="form-control"  type="number" value=0 required />
                <span asp-validation-for="UserIdentity.AccessFailedCount" class="text-danger"></span>
            </div>

            <!-- Roles Selection -->
            @* <div class="form-group">
                <label>Assign Roles</label>
                <select asp-for="AssignedRoles" class="form-control" multiple id="AssignedRoles">
                    @foreach (var role in Model.AvailableRoles)
                    {
                        <option value="@role.Name" selected="@(Model.AssignedRoles.Contains(role.Name) ? "selected" : null)">
                            @role.Name
                        </option>
                    }
                </select>
            </div> *@
            
            
            <!-- Roles Selection with search feature -->
            
            <div class="dropdown">
                <label for="searchInput">Select Roles:</label>
                <input type="text" id="searchInput" placeholder="Type to search..." oninput="filterItems()" />
                <div class="dropdown-list" id="dropdownList"></div>
            </div>
            <div class="selected-items" id="selectedRoles"></div>

            <!-- Other Claims Selection -->
            <div class="form-group">
               
                <div class="form-group">
                    <label class="control-label">Add Custom Claim</label>
                    <input id="customClaimInput"
                           class="form-control"
                           type="text"
                           placeholder="Enter custom claim"
                           pattern="^[a-zA-Z0-9_]+$"
                           minlength="3"
                           maxlength="20" />
                </div>

                <small class="form-text text-muted">
                    Claim must be 3-20 characters long and can only contain letters, numbers, and underscores.
                    
                </small>
                <div>
                    <button id="addClaimButton" class="btn btn-primary" type="button">Add Claim</button>
                </div>

            </div>

            <div class="form-group">
                <label asp-for="SelectedClaims" class="control-label">Claims Selected </label>
                <select asp-for="SelectedClaims" class="form-control" multiple id="selectedClaims" disabled>
                    <!-- Claims will be populated dynamically based on selected roles -->
                </select>

            </div>
            <div id="hiddenSelectedClaimsContainer"></div>

            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="Index">Back to List</a>
</div>


    @section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>

    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
            <script>

            function addCustomClaim() 
            {
                var customClaim = $("#customClaimInput").val().trim(); // Get user-inputted claim
                if (customClaim) 
                {
                    var existingClaims = [];
                    $("#selectedClaims option").each(function() {
                        existingClaims.push($(this).val());
                    });

                    if (!existingClaims.includes(customClaim)) 
                    {
                        // Add new claim
                        $("#selectedClaims").append('<option value="' + customClaim + '">' + customClaim + '</option>');
                    } else {
                        alert("This claim is already in the list.");
                    }
                    updateSelectedClaims(customClaim);
                    // Clear the input field
                    $("#customClaimInput").val('');
                } else {
                    alert("Please enter a valid claim.");
            }
            }

            function updateSelectedClaims(customClaim) {
            var currentCount = $("#hiddenSelectedClaimsContainer input").length;
            $("#hiddenSelectedClaimsContainer").append(
                '<input type="hidden" name="SelectedClaims[' + currentCount + ']" value="' + customClaim + '" />'
            );
        }
            

                var roleClaims = @Html.Raw(Json.Serialize(Model.AvailableClaimsBasedOnRoles));

            function updateClaimsDropdown() 
            {
                
             var selectedRoles = [];
                $("#selectedRoles span").each(function () {
                    selectedRoles.push($(this).text().trim()); // Extract text and trim whitespace
                });
                var claims = [];
                selectedRoles.forEach(function(role) {
                    if (roleClaims[role]) {
                        claims = claims.concat(roleClaims[role]); // Add role's claims
                    }
                });
                claims = [...new Set(claims)]; // Remove duplicate claims

                $("#selectedClaims").empty(); // Clear existing options
                claims.forEach(function(claim) {
                    $("#selectedClaims").append('<option value="' + claim + '">' + claim + '</option>');
                });
            }

                
        var items = @Html.Raw(Json.Serialize(Model.AvailableRolesNames));        
          const selectedItems = [];

        function filterItems() {
            const input = document.getElementById("searchInput").value.toLowerCase();
            const dropdownList = document.getElementById("dropdownList");
            dropdownList.innerHTML = "";

            // Show dropdown only if there's input
            if (input) {
                const filteredItems = items.filter(item =>
                    item.toLowerCase().includes(input) && !selectedItems.includes(item)
                );

                // Populate dropdown
                filteredItems.forEach(item => {
                    const div = document.createElement("div");
                    div.textContent = item;
                    div.onclick = () => {
                        addItem(item);
                        dropdownList.style.display = "none"; // Hide dropdown after selection
                        document.getElementById("searchInput").value = ""; // Clear input
                    };
                    dropdownList.appendChild(div);
                });

                dropdownList.style.display = filteredItems.length > 0 ? "block" : "";
            } else {
                dropdownList.style.display = "";
            }
        }

        function addItem(item) {
            if (!selectedItems.includes(item)) {
                selectedItems.push(item);

                // Update UI
                const selectedItemsDiv = document.getElementById("selectedRoles");
                const itemContainer = document.createElement("div"); // Create a container for item and button
                const span = document.createElement("span");
                span.textContent = item;


                // Add a remove button
                const removeBtn = document.createElement("button");
                removeBtn.type = "button";
                removeBtn.textContent = "x";
                removeBtn.onclick = () => {
                    removeItem(item,itemContainer);
                };

                itemContainer.appendChild(span); // Append the item name
                itemContainer.appendChild(removeBtn);

                //span.appendChild(removeBtn);
                selectedItemsDiv.appendChild(itemContainer);

               updateClaimsDropdown();

            }
        }

        function removeItem(item,itemContainer) {
            // Remove item from selectedItems array
            const index = selectedItems.indexOf(item);
            if (index > -1) {
                selectedItems.splice(index, 1);
            }

                // Update UI: Remove the item container from the list
        itemContainer.remove();
            
            updateClaimsDropdown();
        }

        // Hide dropdown when clicking outside
        document.addEventListener("click", (event) => {
            const dropdown = document.querySelector(".dropdown");
            if (!dropdown.contains(event.target)) {
                document.getElementById("dropdownList").style.display = "";
            }
        });

        $(document).ready(function() {
                    updateClaimsDropdown();

                    $("#selectedRoles").on("change", function() {
                        updateClaimsDropdown();
                    });

                    $("#addClaimButton").on("click", function() {
                    addCustomClaim();
                    });
                });

    </script>

}
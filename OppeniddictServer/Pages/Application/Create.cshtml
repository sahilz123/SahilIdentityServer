@page
@model OppeniddictServer.Pages.Application.CreateModel

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Application</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label>Scope Of the Project</label>
                <select asp-for="Client.Scopes" class="form-control" multiple required>
                    @foreach (var s in Model.AvailableScopes)
                    {
                        <option value="@s.Name" selected="@(Model.Client.Scopes!.Contains(s.Name!) ? "selected" : null)">
                            @s.Name
                        </option>
                    }
                </select>
                <span asp-validation-for="Client.Scopes" class="text-danger"></span>
            </div>
            <div>
                <a asp-page="/Scope/Create">Create Your Own Scopes/Resources</a>
            </div>
            <div class="form-group">
                <label asp-for="Client.ClientId" class="control-label"></label>
                <input asp-for="Client.ClientId" class="form-control" required/>
                <span asp-validation-for="Client.ClientId" class="text-danger"></span>
            </div>
           
            <div class="form-group">
                <label>Client Type</label>
                <select asp-for="Client.ClientType" class="form-control" asp-items="Model.ClientType" required>
                </select>
                <span asp-validation-for="Client.ClientType" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>Consent Type</label>
                <select asp-for="Client.ConsentType" class="form-control" asp-items="Model.ConsentType" required>
                </select>
                <span asp-validation-for="Client.ConsentType" class="text-danger"></span>
            </div>

            @* <div class="form-group">
                <label asp-for="Client.ClientType" class="control-label"></label>
                <input asp-for="Client.ClientType" class="form-control" required/>
                <span asp-validation-for="Client.ClientType" class="text-danger"></span>
            </div>
           
            <div class="form-group">
                <label asp-for="Client.ConsentType" class="control-label"></label>
                <input asp-for="Client.ConsentType" class="form-control" required/>
                <span asp-validation-for="Client.ConsentType" class="text-danger"></span>
            </div> *@
            <div class="form-group">
                <label asp-for="Client.DisplayName" class="control-label"></label>
                <input asp-for="Client.DisplayName" class="form-control" required/>
                <span asp-validation-for="Client.DisplayName" class="text-danger"></span>
            </div>
           
           @*  <div class="form-group">
                <label asp-for="Client.Permissions" class="control-label"></label>
                <input asp-for="Client.Permissions" class="form-control" />
                <span asp-validation-for="Client.Permissions" class="text-danger"></span>
            </div> *@                                                                                     02/feb/2025

            <div class="form-group">
                <label>Select Client Permissions</label>
                <select asp-for="Client.Permissions" class="form-control" multiple required>
                    @foreach (var group in Model.Permission.GroupBy(p => p.Group?.Name))
        {
                    <optgroup label="@group.Key" @(group.First().Group?.Disabled == true ? "disabled" : "")>

                    @foreach (var s in group)
                    {
                                <option value="@s.Value" selected="@(Model.Client.Permissions!.Contains(s.Value!) ? "selected" : null)">
                            @s.Text
                        </option>
                    }
                    </optgroup>
        }
                </select>
                <span asp-validation-for="Client.Permissions" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Client.PostLogoutRedirectUris" class="control-label"></label>
                <input asp-for="Client.PostLogoutRedirectUris" placeholder="Enter Valid URL seperated with Comma(,)"  class="form-control" />
                <span asp-validation-for="Client.PostLogoutRedirectUris" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Client.Properties" class="control-label"></label>
                <input asp-for="Client.Properties" class="form-control" />
                <span asp-validation-for="Client.Properties" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Client.RedirectUris" class="control-label"></label>
                <input asp-for="Client.RedirectUris" class="form-control" placeholder="Enter Valid URL seperated with Comma(,)"  required/>
                <span asp-validation-for="Client.RedirectUris" class="text-danger"></span>
            </div>
           
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

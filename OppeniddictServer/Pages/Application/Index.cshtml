@page
@model OppeniddictServer.Pages.Application.IndexModel

@{
    
    ViewData["Title"] = "Index";
}

<h1>Application Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>

<div style="height:600px;overflow-y:scroll">

<div style="overflow-x: auto; width: 100%;">

<table class="table">
    <thead>
        <tr>

            <th style="max-width: 150px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                @Html.DisplayNameFor(model => model.ApplicationManager[0].ClientId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ApplicationManager[0].ClientSecret)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ApplicationManager[0].ClientType)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ApplicationManager[0].ConcurrencyToken)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ApplicationManager[0].ConsentType)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ApplicationManager[0].DisplayName)
            </th>
           
            <th>
                @Html.DisplayNameFor(model => model.ApplicationManager[0].Permissions)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ApplicationManager[0].PostLogoutRedirectUris)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ApplicationManager[0].Properties)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ApplicationManager[0].RedirectUris)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ApplicationManager[0].Requirements)
            </th>
            
           
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.ApplicationManager) {
        <tr>

            <td style="max-width: 250px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                @Html.DisplayFor(modelItem => item.ClientId)
            </td>
            <td class="text-truncate" style="max-width: 175px;">
                @Html.DisplayFor(modelItem => item.ClientSecret)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ClientType)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ConcurrencyToken)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ConsentType)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DisplayName)
            </td>


            <td class="text-truncate" style="max-width: 175px;">
                @Html.DisplayFor(modelItem => item.Permissions)
            </td>
            <td class="text-truncate" style="max-width: 175px;">
                @Html.DisplayFor(modelItem => item.PostLogoutRedirectUris)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Properties)
            </td>
            <td class="text-truncate" style="max-width: 175px;">
                @Html.DisplayFor(modelItem => item.RedirectUris)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Requirements)
            </td>
           
                <td>
                    <div class="d-flex flex-column">
                        <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-primary btn-sm mb-1">Edit</a>
                        <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-info btn-sm mb-1">Details</a>
                        <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Delete</a>
                    </div>
                </td>

        </tr>
}
    </tbody>
</table>
</div>
</div>

@page
@model OppeniddictServer.Pages.Scope.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Scope Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.ScopesManager[0].ConcurrencyToken)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ScopesManager[0].Description)
            </th>
            
            <th>
                @Html.DisplayNameFor(model => model.ScopesManager[0].DisplayName)
            </th>
           
            <th>
                @Html.DisplayNameFor(model => model.ScopesManager[0].Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ScopesManager[0].Properties)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ScopesManager[0].Resources)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.ScopesManager) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.ConcurrencyToken)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Description)
            </td>
            
            <td>
                @Html.DisplayFor(modelItem => item.DisplayName)
            </td>
           
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Properties)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Resources)
            </td>
            <td>
                    <div class="d-flex flex-column">
                        <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-primary btn-sm mb-1">Edit</a>
                        <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-info btn-sm mb-1">Details</a>
                        <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Delete</a>
                    </div>
            </td>
        </tr>
}
    </tbody>
</table>

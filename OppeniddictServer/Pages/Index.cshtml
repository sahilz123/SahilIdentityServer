@page

@model IndexModel
@{
    ViewData["Title"] = "Index page";
}

<div class="text-center">
    <h1 class="display-4">Welcome To The Identity Server</h1>
    <p>Learn about <a href="https://docs.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>
</div>

<div class="align-content-lg-center">
@if (User.Identity!.IsAuthenticated)
{
    <p>You are logged in as: @User.Identity.Name</p>
    <p>Here is your personalized dashboard content.</p>
}
else
{
    <p>You are not authorized to view this content. Please <a href="~/ServerLogin">log in</a>.</p>
}
</div>